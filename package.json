{
  "name": "mquantum",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "vite",
    "build": "pnpm wasm:build && node scripts/check-untracked-imports.js && node scripts/check-wgsl-backticks.js && node scripts/check-detect-gpu-benchmarks.js && tsc -b && pnpm build:check",
    "build:web": "node scripts/check-untracked-imports.js && node scripts/check-wgsl-backticks.js && node scripts/check-detect-gpu-benchmarks.js && tsc -b && pnpm build:check",
    "build:check": "node scripts/check-chunk-cycles.js",
    "lint:folders": "node scripts/check-folder-file-count.js",
    "bundle:check": "node scripts/check-bundle-size.js",
    "gpu-benchmarks:check": "node scripts/check-detect-gpu-benchmarks.js",
    "gpu-benchmarks:sync": "node scripts/sync-detect-gpu-benchmarks.js",
    "wasm:build": "wasm-pack build ./src/wasm/mdimension_core --target web && rm -f ./src/wasm/mdimension_core/pkg/.gitignore",
    "wasm:build:validator": "wasm-pack build ./src/wasm/mdimension_core --target nodejs --out-dir pkg-validator --features wdw-validator && rm -f ./src/wasm/mdimension_core/pkg-validator/.gitignore",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src/wasm/mdimension_core/Cargo.toml",
    "test:all": "pnpm test && pnpm test:rust",
    "test:watch": "vitest",
    "test:shaders": "WGSL_VALIDATE=1 vitest run src/tests/rendering/wgsl/wgslValidation.test.ts",
    "test:shaders:fast": "WGSL_VALIDATE=1 WGSL_MAX=2000 vitest run src/tests/rendering/wgsl/wgslValidation.test.ts",
    "test:shaders:tint": "WGSL_TINT=1 playwright test scripts/playwright/wgsl-tint-validation.spec.ts",
    "lint": "pnpm lint:folders && eslint . --max-warnings 0 --no-warn-ignored",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src/wasm/mdimension_core/Cargo.toml",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:rust": "cargo fmt --manifest-path src/wasm/mdimension_core/Cargo.toml",
    "test:mutate": "stryker run",
    "test:mutate:incremental": "stryker run --incremental",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "detect-gpu": "^5.0.70",
    "fzstd": "^0.1.1",
    "mediabunny": "^1.66.2",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/compiler": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/expect": "^5.1.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "madge": "^8.0.0",
    "playwright": "^1.65.1",
    "png-to-ico": "^3.0.2",
    "portless": "^0.18.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "ts-prune": "^0.10.3",
    "ttf2woff2": "^8.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.1"
  },
  "portless": {
    "name": "mquantum",
    "script": "dev:app"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "node scripts/check-folder-file-count.js",
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "not op_mini all",
    "not ie <= 11",
    "not safari < 12",
    "not android < 6"
  ]
}
